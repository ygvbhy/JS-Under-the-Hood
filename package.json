{
  "name": "js-under-the-hood",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node --env-file-if-exists=.env scripts/postbuild.mjs",
    "start": "serve build/client --config ../../serve.json",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "3.1.1",
    "@react-router/dev": "8.5.0",
    "@shikijs/rehype": "4.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "remark-code-import": "1.2.0",
    "serve": "14.2.6",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
